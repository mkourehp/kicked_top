&system
  h = 1.5707963267948966
  eps = 0.2           ! k/(2j) for k = 2.4, j = 6
  j = 6
/
&simulation
  n_kicks = 30
/
&initial
  theta0 = 1.5707963267948966
  phi0 = -1.5707963267948966
/
&husimi
  enabled = .true.
  n_theta = 100
  n_phi = 200
  kicks = 0, 5, 10, 30
/
&spectrum
  enabled = .false.
/
&output
  out_dir = 'docs/initial_condition/figures/data/island_quantum'
/

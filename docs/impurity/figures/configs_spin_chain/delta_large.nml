! Figures of docs/impurity/impurity.tex: qubit chain with a static impurity of width delta = deltaz = deltax.
! The three configs differ only in deltaz, deltax and out_dir; impurity.tex reads all values from them.

&system
  n_q = 10                 ! number of qubits, j = n_q/2
  eps = 2.0                ! coupling, k/n_q for the classical torsion strength k = 20
  h   = 0.1                ! kick angle about x (mixed regime for k = 20)
  deltaz = 0.5             ! static impurity of the zz couplings, xi_il uniform in [-deltaz/2, deltaz/2]
  deltax = 0.5             ! static impurity of the kicks, eta_k uniform in [-deltax/2, deltax/2]
  imp_seed = 12345         ! seed of the impurity offsets
/

&initial
  s0  = -1                 ! -1: all qubits up, 0: all down (only ferromagnetic states)
  pol = 'z'                ! axis of the polarisation: 'z', 'x' or 'y'
/

&chain
  t_r = 30                 ! forward steps before the time reversal (then t_r backward steps)
  butterfly_effect = .false. ! no qubit flip at t_r
/

&husimi
  n_theta = 100            ! grid points in Z
  n_phi   = 200            ! grid points in phi
/

&output
  out_dir = 'docs/impurity/figures/data/delta_large'
/

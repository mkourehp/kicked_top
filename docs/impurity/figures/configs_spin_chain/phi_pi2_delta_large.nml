! Figures of docs/impurity/impurity.tex: qubit chain with a static impurity of width delta = deltaz = deltax.
! Two initial states (theta0, phi0), three impurity widths each: the configs differ only in phi0, deltaz, deltax
! and out_dir; impurity.tex reads all values from them.

&system
  n_q = 16                 ! number of qubits, j = n_q/2
  eps = 1.25               ! coupling, k/n_q for the classical torsion strength k = 20
  h   = 0.1                ! kick angle about x (mixed regime for k = 20)
  deltaz = 0.01            ! static impurity of the zz couplings, xi_il uniform in [-deltaz/2, deltaz/2]
  deltax = 0.01            ! static impurity of the kicks, eta_k uniform in [-deltax/2, deltax/2]
  imp_seed = 12345         ! seed of the impurity offsets
/

&initial
  theta0 = 1.5707963267948966   ! pi/2, initial spin coherent state |theta0, phi0> of every qubit
  phi0   = 1.5707963267948966   ! pi/2
/

&chain
  t_r = 30                 ! forward steps before the time reversal (then t_r backward steps)
  butterfly_effect = .false. ! no qubit flip at t_r
/

&husimi
  n_theta = 100            ! grid points in Z
  n_phi   = 200            ! grid points in phi
/

&output
  out_dir = 'docs/impurity/figures/data/phi_pi2_delta_large'
/

! Figures of docs/impurity/impurity.tex: qubit chain, butterfly effect without impurity.
! Butterfly runs (butterfly_*): no impurity, qubit i_flip rotated about flip_axis by flip_angle at t_r.
! impurity.tex reads all values from the configs.

&system
  n_q = 16                 ! number of qubits, j = n_q/2
  eps = 1.25               ! coupling, k/n_q for the classical torsion strength k = 20
  h   = 0.1                ! kick angle about x (mixed regime for k = 20)
  deltaz = 0.0             ! static impurity of the zz couplings, xi_il uniform in [-deltaz/2, deltaz/2]
  deltax = 0.0             ! static impurity of the kicks, eta_k uniform in [-deltax/2, deltax/2]
  imp_seed = 12345         ! seed of the impurity offsets
/

&initial
  theta0 = 1.5707963267948966   ! pi/2, initial spin coherent state |theta0, phi0> of every qubit
  phi0   = 1.5707963267948966   ! pi/2
/

&chain
  t_r = 30                 ! forward steps before the time reversal (then t_r backward steps)
  butterfly_effect = .true. ! rotate qubit i_flip at t_r, before the backward leg
  i_flip = 1               ! index (1 .. n_q) of the rotated qubit
  flip_axis = 'x'          ! rotation axis
  flip_angle = 0.7853981633974483 ! pi/4, exp(-i flip_angle/2 sigma^a)
/

&husimi
  n_theta = 100            ! grid points in Z
  n_phi   = 200            ! grid points in phi
/

&output
  out_dir = 'docs/impurity/figures/data/butterfly_phi_pi2_x_pi4'
/

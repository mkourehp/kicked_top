! Quantum kicked top: H = eps J_z^2 + h J_x sum_n delta(t-n),
! U = exp(-i eps J_z^2) exp(-i h J_x), spin j (integer or half-integer); eps = k/(2j).
! Angles in radians.

&system
  h = 1.5707963267948966   ! pi/2
  eps = 0.20833333333333334 ! k/(2j) for k = 2.5
  j = 6                   ! Hilbert-space dimension 2j+1
/

&simulation
  n_kicks = 100
/

&initial
  theta0 = 2.25   ! centre of the initial spin coherent state (polar angle, [0, pi])
  phi0   = -0.94  ! (azimuth)
/

&husimi
  enabled = .true.
  n_theta = 100              ! grid points in Z = cos(theta) (equal-area grid)
  n_phi   = 200              ! grid points in phi
  n_husimi = 0               ! if > 0: also n_husimi kicks evenly spaced over [0, n_kicks]
  kicks   = 0, 10, 50, 100   ! kicks at which the Husimi distribution is written
/

&spectrum
  enabled = .false.   ! quasienergies of U and their spacing statistics
  n_bins  = 30
  s_max   = 3.0
/

&output
  out_dir = 'output_quantum'
/

! Qubit chain alone (kicked_top_spin_chain, make spin_chain); kicked_top_combined reads the same
! groups plus &classical (config_combined.nml).
! The chain has n_q qubits, J = (1/2) sum_i sigma_i, j = n_q/2:
! H = eps sum_{i,l} V_il sigma^z_i sigma^z_l + h J_x sum_n delta(t-n), V_il = 1/4 (H_zz = J_z^2),
! h J_x = (h/2) sum_i sigma^x_i, U = exp(-i eps H_zz) exp(-i h J_x), eps = k/(2j) = k/n_q.

&system
  n_q = 10                 ! number of qubits, j = n_q/2
  eps = 2.0                ! coupling, k/n_q for the classical torsion strength k = 20
  h   = 0.02, 0.1, 1.0     ! kick angles about x, one run per value: regular, mixed, chaotic (for k = 20)
/

&initial
  s0  = -1                 ! -1: all qubits up, 0: all down (only ferromagnetic states)
  pol = 'z'                ! axis of the polarisation: 'z', 'x' or 'y'
  ! theta0 = 1.5707963267948966 ! if theta0 and phi0 are both given, the initial state is the product
  ! phi0   = 0.0                ! coherent state |theta0, phi0> and s0, pol are ignored
/


&chain
  t_r = 30                 ! forward steps before the time reversal (then t_r backward steps)
  butterfly_effect = .true. ! flip qubit i_flip at t_r, before the backward leg
  i_flip = 1               ! index (1 .. n_q) of the flipped qubit
  flip_axis = 'x'          ! rotation axis a = 'x', 'y' or 'z' of qubit i_flip
  flip_angle = 3.141592653589793 ! rotation angle: exp(-i flip_angle/2 sigma^a); pi = full flip sigma^a
/

&husimi
  n_theta = 100            ! grid points in Z
  n_phi   = 200            ! grid points in phi
/

&output
  out_dir = 'output_spin_chain'
/
